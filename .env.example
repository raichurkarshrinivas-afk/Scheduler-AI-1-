# ==============================================================================
# Scheduler - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure all variables appropriately.
# NEVER commit the actual .env file or real secrets to source control.

# Application & Environment Mode
PROJECT_NAME="Scheduler"
VERSION="1.0.0"
ENVIRONMENT="development"      # Set to "production" in live environments
DEBUG=false
LOG_LEVEL="INFO"              # DEBUG, INFO, WARNING, ERROR, CRITICAL

# API Routing
API_V1_STR="/api/v1"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL 16 is recommended for production deployments.
# Containerized network URL (inside Docker Compose):
DATABASE_URL="postgresql+psycopg://scheduler_user:scheduler_password@db:5432/scheduler"

# Local host development URL (connecting to exposed container port 5432):
# DATABASE_URL="postgresql+psycopg://scheduler_user:scheduler_password@localhost:5432/scheduler"

# Local SQLite fallback for lightweight development/testing only:
# DATABASE_URL="sqlite:///./scheduler.db"

# PostgreSQL Service Credentials (used by Docker Compose)
POSTGRES_DB="scheduler"
POSTGRES_USER="scheduler_user"
POSTGRES_PASSWORD="replace_with_a_secure_postgres_password"
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Security & Cryptography Keys
# ------------------------------------------------------------------------------
# SECRET_KEY: Used for signing JWT session tokens and CSRF tokens.
# Generation command:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   OR: openssl rand -hex 32
# KEY ROTATION IMPACT:
#   Rotating SECRET_KEY immediately invalidates all active user sessions and
#   CSRF tokens. All connected users will be required to log in again.
SECRET_KEY="generate-and-place-a-random-32-byte-secret-key-here"

# ENCRYPTION_KEY: Optional 32-byte (256-bit) hex key for database field encryption.
# Generation command:
#   python -c "import secrets; print(secrets.token_hex(32))"
# KEY ROTATION IMPACT:
#   Rotating ENCRYPTION_KEY requires executing a migration script to decrypt
#   existing values with the old key and re-encrypt with the new key.
ENCRYPTION_KEY="generate-and-place-a-random-32-byte-hex-key-here"

# Seed administrator password for initial migration & setup
# Must be at least 12 characters, including upper, lower, numbers, and symbols.
SEED_PASSWORD="replace_with_initial_strong_admin_password_2026!"

# Token & Session Parameters
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
SESSION_COOKIE_NAME="scheduler_session"
CSRF_COOKIE_NAME="scheduler_csrf"
COOKIE_SECURE=false                # Set to true in HTTPS production!
COOKIE_SAMESITE="lax"
SESSION_EXPIRE_SECONDS=604800      # 7 days

# Rate Limiting
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# Reverse Proxy & CORS Allowed Origins
# ------------------------------------------------------------------------------
# JSON-encoded array of allowed origins for cross-origin requests
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:80","http://localhost"]'

# ------------------------------------------------------------------------------
# Background Worker Parameters
# ------------------------------------------------------------------------------
WORKER_POLL_INTERVAL=2.0
WORKER_LEASE_DURATION=30
WORKER_HEARTBEAT_INTERVAL=5.0
WORKER_MAX_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Backup & Disaster Recovery Retention
# ------------------------------------------------------------------------------
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_WEEKS=4
BACKUP_RETENTION_MONTHLY_MONTHS=12

# ------------------------------------------------------------------------------
# Optional AI Interpretation Service (Phase 13)
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_PROVIDER="mock"                 # disabled, mock, openai, gemini, external
AI_API_KEY=""
AI_MODEL_NAME="gpt-4o-mini"
AI_TIMEOUT_SECONDS=10.0
AI_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# Optional Google Calendar Integration (Phase 11)
# ------------------------------------------------------------------------------
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GOOGLE_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# Frontend Client Environment
# ------------------------------------------------------------------------------
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"
